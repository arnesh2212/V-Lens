*.pyc
__pycache__/
.ipynb_checkpoints/
*:Zone.Identifier
.venv/
venv/
.env
.DS_Store
.plotsync/
# a lane's progress belongs to the machine running it, not to the checkout
queue/*.q.done*
queue/*.q.attempts
queue/*.q.dropped
queue/*.q.bak
# queue backups and progress markers, and a stray Hugging Face cache
queue/*.bak*
queue/*.pre_switch
queue/*.cut*
queue/bak_*/
*.done
*.done.lines
/hf/
!supplement/*.md
